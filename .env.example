POSTGRES_DB=asm_platform
POSTGRES_USER=asm
POSTGRES_PASSWORD=asm_dev_password
POSTGRES_PORT=5432

JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=120

# Valid values:
# mock  = deterministic demo data
# tools = execute recon-engine/submerge.sh and scanner modules
ASM_SCAN_MODE=tools
ASM_PROJECT_ROOT=..
ASM_WORKSPACE=./data/workspace
SUBMERGE_OUTPUT_ROOT=output
SUBMERGE_PATH=recon-engine/submerge.sh
HTTPX_PATH=httpx
NMAP_PATH=nmap
WHATWEB_PATH=whatweb
NUCLEI_PATH=nuclei
SCAN_TIMEOUT_SECONDS=600

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
